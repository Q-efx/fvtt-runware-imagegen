<div class="runware-image-form">

  {{#if isGenerating}}
  <div class="runware-loading">
    <i class="fas fa-spinner"></i>
    <span>Generating image, please wait...</span>
  </div>
  {{/if}}

  <!-- Actor Information -->
  <div class="runware-form-section">
    <h3><i class="fas fa-user"></i> Actor Information</h3>
    <div class="runware-form-group">
      <label>Generating for:</label>
      <input type="text" value="{{actorName}}" readonly disabled />
    </div>
  </div>

  <!-- Prompt Section -->
  <div class="runware-form-section">
    <h3><i class="fas fa-pencil-alt"></i> Image Prompt</h3>

    <div class="runware-form-group">
      <label for="{{partId}}-prompt">Positive Prompt *</label>
      <textarea
        name="prompt"
        id="{{partId}}-prompt"
        placeholder="Describe the image you want to generate..."
        required
        {{#if isGenerating}}disabled{{/if}}
      >{{prompt}}</textarea>
      <small>Describe what you want to see in the image</small>
    </div>

    <div class="runware-form-group">
      <label for="{{partId}}-negativePrompt">Negative Prompt</label>
      <textarea
        name="negativePrompt"
        id="{{partId}}-negativePrompt"
        placeholder="Describe what you don't want to see..."
        {{#if isGenerating}}disabled{{/if}}
      >{{negativePrompt}}</textarea>
      <small>Optional: Describe what you want to avoid in the image</small>
    </div>
  </div>

  <!-- Model Selection -->
  <div class="runware-form-section">
    <h3><i class="fas fa-brain"></i> Model Configuration</h3>

    {{#if presets.length}}
    <div class="runware-form-group preset-selector">
      <label for="{{partId}}-presetSelection">Preset</label>
      <div class="preset-controls">
        <select name="presetSelection" id="{{partId}}-presetSelection" {{#if isGenerating}}disabled{{/if}}>
          {{selectOptions presetOptions selected=appliedPresetId blank="Select a preset..."}}
        </select>
        {{#if canManagePresets}}
        <button type="button" data-action="managePresets" title="Manage presets" {{#if isGenerating}}disabled{{/if}}>
          <i class="fas fa-sliders-h"></i>
        </button>
        {{/if}}
      </div>
      <small>Prefill model, LoRA, VAE, and embeddings using a preset defined by the GM.</small>
    </div>
    {{else}}
      {{#if canManagePresets}}
      <div class="runware-form-group preset-selector">
        <label>Presets</label>
        <button type="button" data-action="managePresets" {{#if isGenerating}}disabled{{/if}}>
          <i class="fas fa-sliders-h"></i> Configure Presets
        </button>
        <small>No presets configured yet. Click to add some for your players.</small>
      </div>
      {{/if}}
    {{/if}}

    <div class="runware-form-group">
      <label for="{{partId}}-model">AI Model *</label>
      <input
        type="text"
        name="model"
        id="{{partId}}-model"
        value="{{defaultModel}}"
        placeholder="e.g., runware:100@1"
        required
        {{#if isGenerating}}disabled{{/if}}
      />
      <small>The AI model to use for generation</small>

      <div class="model-suggestions">
        {{#each modelSuggestions}}
        <button type="button" data-action="modelSuggestion" data-model="{{this.value}}" {{#if ../isGenerating}}disabled{{/if}}>
          {{this.label}}
        </button>
        {{/each}}
      </div>
    </div>

    <!-- Image Dimensions -->
    <div class="runware-dimensions">
      <div class="runware-form-group">
        <label for="{{partId}}-width">Width</label>
        <input
          type="number"
          name="width"
          id="{{partId}}-width"
          value="{{imageWidth}}"
          min="256"
          max="2048"
          step="64"
          {{#if isGenerating}}disabled{{/if}}
        />
      </div>

      <div class="runware-form-group">
        <label for="{{partId}}-height">Height</label>
        <input
          type="number"
          name="height"
          id="{{partId}}-height"
          value="{{imageHeight}}"
          min="256"
          max="2048"
          step="64"
          {{#if isGenerating}}disabled{{/if}}
        />
      </div>
    </div>

    <div class="runware-form-group">
      <label for="{{partId}}-numberResults">Number of Images</label>
      <input
        type="number"
        name="numberResults"
        id="{{partId}}-numberResults"
        value="{{numberResults}}"
        min="1"
        max="4"
        step="1"
        {{#if isGenerating}}disabled{{/if}}
      />
      <small>How many images to generate (1-4)</small>
    </div>

    <div class="runware-form-group">
      <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
        <input type="checkbox" name="removeBackground" {{#if removeBackground}}checked{{/if}} {{#if isGenerating}}disabled{{/if}} style="width: auto; margin: 0;">
        Remove Background
      </label>
      <small>Automatically remove the background from the generated image</small>
    </div>
  </div>

  <!-- Advanced Options -->
  <div class="runware-form-section">
    <h3><i class="fas fa-cog"></i> Advanced Options</h3>

    <div class="advanced-options">
      <button type="button" class="advanced-toggle{{#unless advancedExpanded}} collapsed{{/unless}}" data-action="toggleAdvanced">
        <span>Show Advanced Options</span>
        <i class="fas fa-chevron-down"></i>
      </button>

      <div class="advanced-content{{#if advancedExpanded}} expanded{{/if}}">
        <!-- LoRA Model -->
        <div class="runware-form-group">
          <label>LoRA Model (Optional)</label>
          <div class="lora-config">
            <input
              type="text"
              name="loraModel"
              value="{{loraModel}}"
              placeholder="e.g., civitai:12345@67890"
              {{#if isGenerating}}disabled{{/if}}
            />
            <div class="runware-form-group" style="margin: 0;">
              <label for="{{partId}}-loraWeight">Weight</label>
              <input
                type="number"
                name="loraWeight"
                id="{{partId}}-loraWeight"
                value="{{loraWeight}}"
                min="-4"
                max="4"
                step="0.1"
                {{#if isGenerating}}disabled{{/if}}
              />
            </div>
          </div>
          <div class="runware-form-group" style="margin: 0;">
            <label for="{{partId}}-loraTrigger">Trigger Word</label>
            <input
              type="text"
              name="loraTrigger"
              id="{{partId}}-loraTrigger"
              value="{{loraTrigger}}"
              placeholder="e.g., style keyword"
              {{#if isGenerating}}disabled{{/if}}
            />
          </div>
          <small>Optional LoRA model for style adaptation. Trigger word automatically prepends to the positive prompt when provided.</small>
        </div>

        <div class="runware-form-group">
          <label for="{{partId}}-vaeModel">VAE (Optional)</label>
          <input
            type="text"
            name="vaeModel"
            id="{{partId}}-vaeModel"
            value="{{vaeModel}}"
            placeholder="e.g., runware:vae@1"
            {{#if isGenerating}}disabled{{/if}}
          />
          <small>Override the default VAE used with the chosen model.</small>
        </div>

        <div class="runware-form-group">
          <label for="{{partId}}-embeddings">Embeddings (Optional)</label>
          <textarea
            name="embeddings"
            id="{{partId}}-embeddings"
            placeholder="One embedding per line. Optionally append :weight, e.g., civitai:12345@67890:0.8"
            {{#if isGenerating}}disabled{{/if}}
          >{{embeddings}}</textarea>
          <small>Embeddings adjust the prompt with additional learned concepts.</small>
        </div>

        <!-- Steps -->
        <div class="runware-form-group">
          <label for="{{partId}}-steps">Inference Steps</label>
          <input
            type="number"
            name="steps"
            id="{{partId}}-steps"
            value="{{steps}}"
            placeholder="20-50 recommended"
            min="1"
            max="150"
            {{#if isGenerating}}disabled{{/if}}
          />
          <small>Number of denoising steps (more = higher quality, slower)</small>
        </div>

        <!-- CFG Scale -->
        <div class="runware-form-group">
          <label for="{{partId}}-cfgScale">CFG Scale</label>
          <input
            type="number"
            name="cfgScale"
            id="{{partId}}-cfgScale"
            value="{{cfgScale}}"
            placeholder="7.0 recommended"
            min="1"
            max="30"
            step="0.5"
            {{#if isGenerating}}disabled{{/if}}
          />
          <small>How closely to follow the prompt (higher = more literal)</small>
        </div>

        <!-- Seed -->
        <div class="runware-form-group">
          <label for="{{partId}}-seed">Seed (Optional)</label>
          <input
            type="number"
            name="seed"
            id="{{partId}}-seed"
            value="{{seed}}"
            placeholder="Leave empty for random"
            {{#if isGenerating}}disabled{{/if}}
          />
          <small>For reproducible results, use the same seed</small>
        </div>
      </div>
    </div>
  </div>

  <!-- Action Buttons -->
  <div class="runware-actions">
    <button type="button" data-action="cancel" {{#if isGenerating}}disabled{{/if}}>
      <i class="fas fa-times"></i> Cancel
    </button>
    <button type="button" data-action="generate" {{#if isGenerating}}disabled{{/if}}>
      <i class="fas fa-magic"></i> Generate Image
    </button>
  </div>

</div>
